# ----------------------------------------------------------------------
# BASE DIRECTORY PATHS
# Adjust these if your project structure changes
# ----------------------------------------------------------------------
NORMALIZED_DATA_DIR= ../../Merged_Data_Preprocessing/Normalized_Data_split
RESAMPLED_DATA_DIR= ../../Merged_Data_Preprocessing/Resampled_Data_split

# ----------------------------------------------------------------------
# X_TRAIN PATHS (Features used for training)
# Assuming these are the Parquet files saved from your normalization steps
# ----------------------------------------------------------------------
X_TRAIN_SMOTE=${NORMALIZED_DATA_DIR}/X_train_smote.parquet
X_TRAIN_TOMEK=${NORMALIZED_DATA_DIR}/X_train_tomek.parquet
X_TRAIN_SMOTE_TOMEK=${NORMALIZED_DATA_DIR}/X_train_smote_tomek.parquet


#  y_train
Y_TRAIN_SMOTE=${RESAMPLED_DATA_DIR}/smote/y_smote.pkl
Y_TRAIN_TOMEK=${RESAMPLED_DATA_DIR}/tomek/y_tomek.pkl
Y_TRAIN_SMOTE_TOMEK=${RESAMPLED_DATA_DIR}/smote_tomek/y_smote_tomek.pkl

# ----------------------------------------------------------------------
# X_SPLIT PATHS (Features for testing and validation)
# Assuming these paths are common for all resampling experiments
# ----------------------------------------------------------------------
X_VAL=${RESAMPLED_DATA_DIR}/val/X_val.parquet
X_TEST=${RESAMPLED_DATA_DIR}/test/X_test.parquet

# ----------------------------------------------------------------------
# Y_SPLIT PATHS (Targets - assuming you saved them as CSV)
# You will need to reload the corresponding y set for each X set
# ----------------------------------------------------------------------
Y_TEST=${RESAMPLED_DATA_DIR}/test/y_test.pkl
Y_VAL=${RESAMPLED_DATA_DIR}/val/y_val.pkl